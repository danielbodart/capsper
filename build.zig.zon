.{
    .name = .capsper,
    .version = "0.0.1",
    .dependencies = .{
        .minish = .{
            // Pin to the immutable v0.1.0 tag — NOT main.tar.gz, which is a
            // moving branch: upstream advancing main (0.1.0 → 0.3.0) broke the
            // hash and failed CI on every push. Tag tarball is byte-identical
            // to the pinned hash.
            .url = "https://github.com/CogitatorTech/minish/archive/refs/tags/v0.1.0.tar.gz",
            .hash = "minish-0.1.0-SQtSTWHkAQACfz3xGuWHU8zbx320vK_47r2yto3Pq0Rf",
        },
    },
    .fingerprint = 0x96b25de6bfb46ec7,
    .minimum_zig_version = "0.15.2",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
